# Docker dentro de un contenedor de sistema (Sysbox), para el juego «Contenedores rebeldes».
# Trae la imagen de alpine ya guardada (la deja build.sh), así el lab no necesita salir a Internet.
# El juego la carga con docker load al empezar.
FROM nestybox/ubuntu-noble-systemd-docker
COPY alpine.tar /opt/relavops/alpine.tar
