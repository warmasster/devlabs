#!/bin/sh
# Abre el cofre de este servidor (si lo hay). El juego lo detecta y te da el premio.
if [ -f /etc/relavops/cofre ]; then
  if [ -f /run/cofre-abierto ]; then echo "Este cofre ya está vacío."; exit 0; fi
  touch /run/cofre-abierto
  printf '\033[1;33m[cofre] %s\033[0m\n' "$(cat /etc/relavops/cofre)"
else
  echo "Aquí no hay ningún cofre."
fi
