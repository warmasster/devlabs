#!/bin/sh
# Comando desbloqueable: te dice dónde está el boss (el juego escribe su posición aquí).
if [ ! -f /etc/relavops/radar-ok ]; then
  echo "radar: comando bloqueado. Búscalo en algún cofre."; exit 1
fi
printf '\033[1;35m[radar] El boss está en: %s\033[0m\n' "$(cat /run/boss 2>/dev/null || echo '¿?')"
